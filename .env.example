# Telegram Bot API token from @BotFather (required for the bot binary)
BOT_TOKEN=

# Comma-separated whitelist of Telegram usernames (without @) allowed to use
# the bot. Empty = everyone is allowed. Example: alice,bob,carol
ALLOWED_USERS=

# Comma-separated whitelist of Telegram usernames (without @) allowed to run
# admin commands (e.g. /qrlogin_shared to log in the shared service account).
# Empty = admin commands are disabled. Example: alice
ADMIN_USERS=

# MTProto app credentials from https://my.telegram.org/apps (required for the backend)
TG_API_ID=
TG_API_HASH=

# 32-byte AES-256 key, hex-encoded (64 chars), used to encrypt MTProto sessions at rest.
# Generate with: openssl rand -hex 32
SESSION_KEY=

# OpenCode headless server (opencode serve)
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
# Shared basic-auth password: used by `opencode serve` (as OPENCODE_SERVER_PASSWORD)
# and by the bot to connect to it.
OPENCODE_SERVER_PASSWORD=
# DeepSeek API key (opencode serve authenticates to DeepSeek with this)
DEEPSEEK_API_KEY=
# DeepSeek model id in OpenCode `provider/model` form.
OPENCODE_MODEL=deepseek/deepseek-flash

# Backend listen/dial address (backend listens here; bot and MCP dial it)
BACKEND_ADDR=127.0.0.1:9090

# Voice messages (Vosk STT)
# STT_ENABLED=true enables voice-question transcription; requires the stt service.
STT_ENABLED=false
STT_ADDR=127.0.0.1:2700
# Path to the Vosk model (used by the stt service)
STT_MODEL_DIR=/opt/tg-lurk-ai-bot/models/vosk

# Data directory (SQLite DB + encrypted sessions)
DATA_DIR=/opt/tg-lurk-ai-bot/data
