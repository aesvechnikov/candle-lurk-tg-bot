# Telegram Bot API token from @BotFather (required for the bot binary)
BOT_TOKEN=

# MTProto app credentials from https://my.telegram.org/apps (required for the backend)
TG_API_ID=
TG_API_HASH=

# 32-byte AES-256 key, hex-encoded (64 chars), used to encrypt MTProto sessions at rest.
# Generate with: openssl rand -hex 32
SESSION_KEY=

# OpenCode headless server (opencode serve)
OPENCODE_URL=http://127.0.0.1:4096
OPENCODE_USERNAME=opencode
# Shared basic-auth password: used by `opencode serve` (as OPENCODE_SERVER_PASSWORD)
# and by the bot to connect to it.
OPENCODE_SERVER_PASSWORD=
# DeepSeek API key (opencode serve authenticates to DeepSeek with this)
DEEPSEEK_API_KEY=
# DeepSeek model id in OpenCode `provider/model` form.
OPENCODE_MODEL=deepseek/deepseek-chat

# Backend listen/dial address (backend listens here; bot and MCP dial it)
BACKEND_ADDR=127.0.0.1:9090

# Data directory (SQLite DB + encrypted sessions)
DATA_DIR=/opt/candle-lurk-tg-bot/data
