[Unit]
Description=tg-lurk-ai-bot backend (MTProto search)
After=network.target

[Service]
User=lurk_ai_bot
Group=users
EnvironmentFile=/etc/tg-lurk-ai-bot/env
WorkingDirectory=/opt/tg-lurk-ai-bot
ExecStart=/opt/tg-lurk-ai-bot/bin/backend
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
