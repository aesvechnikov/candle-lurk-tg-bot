[Unit]
Description=tg-lurk-ai-bot Telegram bot
After=network.target backend.service opencode-serve.service

[Service]
User=lurk_ai_bot
Group=users
EnvironmentFile=/etc/tg-lurk-ai-bot/env
WorkingDirectory=/opt/tg-lurk-ai-bot
ExecStart=/opt/tg-lurk-ai-bot/bin/tg-lurk-ai-bot
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
