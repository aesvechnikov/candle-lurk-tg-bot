[Unit]
Description=candle-lurk-tg-bot opencode serve (agent + MCP)
After=network.target

[Service]
User=candle
Group=candle
EnvironmentFile=/etc/candle-lurk-tg-bot/env
WorkingDirectory=/opt/candle-lurk-tg-bot
ExecStart=/usr/local/bin/opencode serve --hostname 127.0.0.1 --port 4096
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
